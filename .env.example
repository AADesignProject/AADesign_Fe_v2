# Copy to .env.local (never commit real values). See README, section "Biến môi trường".

# --- Public: inlined into the browser bundle, no secrets here ---
# Canonical / hreflang / sitemap origin. Falls back to https://aa-design.vn when empty.
NEXT_PUBLIC_SITE_URL=
# Image CDN origin, no trailing slash (e.g. https://img.aa-design.vn). When set,
# /images/project/** is served from it (bucket keys mirror the site path:
# images/project/...) and paths without a leading "/" get it as prefix.
# Empty = photos are served from public/.
NEXT_PUBLIC_LINK_S3=
# Google Search Console verification token. Empty = no meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
